# Copy this file to .env for LOCAL XAMPP development.
# Never commit your real .env to GitHub — it's already in .gitignore.
# On Render/Railway you will NOT use this file — you'll set these as
# real environment variables in the platform's dashboard instead.

APP_ENV=local

DB_HOST=localhost
DB_PORT=3306
DB_NAME=serviceconnect
DB_USER=root
DB_PASS=
